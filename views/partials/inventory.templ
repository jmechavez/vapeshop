package partials

import (
	"fmt"
	"net/url"

	"github.com/jmechavez/vapeshop/internal/inventory"
)

// ---------- Inventory list (Table + Pagination ONLY) ----------

templ InventoryTableResults(rows []inventory.InventoryRow, filter inventory.ListFilter, page inventory.Page) {
	<div class="bg-zinc-900 border border-zinc-800 rounded-md overflow-hidden">
		<!-- Desktop -->
		<div class="hidden md:block overflow-x-auto">
			<table class="min-w-full text-sm">
				<thead class="bg-zinc-950/60 text-zinc-400">
					<tr>
						<th class="text-left font-medium px-4 py-2">SKU</th>
						<th class="text-left font-medium px-4 py-2">Product</th>
						<th class="text-right font-medium px-4 py-2">Stock</th>
						<th class="text-right font-medium px-4 py-2">Min</th>
						<th class="text-left font-medium px-4 py-2">Status</th>
						<th class="text-right font-medium px-4 py-2">Actions</th>
					</tr>
				</thead>
				<tbody id="inventory-rows">
					if len(rows) == 0 {
						<tr>
							<td colspan="6" class="px-4 py-12 text-center">
								<p class="text-zinc-400 text-sm">
									if filter.Query != "" {
										No products match "{ filter.Query }".
									} else if filter.LowOnly {
										No products are low on stock. 🎉
									} else {
										No products yet.
									}
								</p>
							</td>
						</tr>
					}
					for _, row := range rows {
						@InventoryRow(row)
					}
				</tbody>
			</table>
		</div>

		<!-- Mobile -->
		<div class="md:hidden divide-y divide-zinc-800">
			if len(rows) == 0 {
				<div class="px-6 py-12 text-center">
					<p class="text-zinc-400 text-sm">
						if filter.Query != "" {
							No products match "{ filter.Query }".
						} else if filter.LowOnly {
							No products are low on stock. 🎉
						} else {
							No products yet.
						}
					</p>
				</div>
			}
			for _, row := range rows {
				@InventoryCardMobile(row)
			}
		</div>

		<!-- Pagination -->
		if page.Total > 0 {
			@InventoryPagination(filter, page)
		}
	</div>
}

templ InventoryPagination(filter inventory.ListFilter, page inventory.Page) {
	<div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-4 py-3 border-t border-zinc-800 bg-zinc-950/40 text-sm">
		<div class="text-zinc-400 tabular-nums">
			Showing <span class="text-zinc-200">{ fmt.Sprint(page.From()) }</span>–<span class="text-zinc-200">{ fmt.Sprint(page.To()) }</span>
			of <span class="text-zinc-200">{ fmt.Sprint(page.Total) }</span>
		</div>
		<div class="flex items-center gap-1">
			<button
				type="button"
				class={ "min-h-[36px] px-3 py-1.5 rounded-sm border transition",
					templ.KV("border-zinc-800 text-zinc-300 hover:border-zinc-700 hover:text-white active:scale-95", page.HasPrev()),
					templ.KV("border-zinc-800/50 text-zinc-600 cursor-not-allowed", !page.HasPrev()),
				}
				if !page.HasPrev() {
					disabled
				}
				hx-get={ inventoryPageURL(filter, page.Page-1) }
				hx-target="#inventory-results"
				hx-swap="innerHTML"
				hx-push-url="true"
			>
				‹ Prev
			</button>
			<span class="px-3 text-zinc-400 tabular-nums">
				Page <span class="text-zinc-200">{ fmt.Sprint(page.Page) }</span>
				of <span class="text-zinc-200">{ fmt.Sprint(page.TotalPages()) }</span>
			</span>
			<button
				type="button"
				class={ "min-h-[36px] px-3 py-1.5 rounded-sm border transition",
					templ.KV("border-zinc-800 text-zinc-300 hover:border-zinc-700 hover:text-white active:scale-95", page.HasNext()),
					templ.KV("border-zinc-800/50 text-zinc-600 cursor-not-allowed", !page.HasNext()),
				}
				if !page.HasNext() {
					disabled
				}
				hx-get={ inventoryPageURL(filter, page.Page+1) }
				hx-target="#inventory-results"
				hx-swap="innerHTML"
				hx-push-url="true"
			>
				Next ›
			</button>
		</div>
	</div>
}

func inventoryPageURL(f inventory.ListFilter, page int) string {
	if page < 1 {
		page = 1
	}
	v := url.Values{}
	if f.Query != "" {
		v.Set("q", f.Query)
	}
	if f.LowOnly {
		v.Set("low", "1")
	}
	if page > 1 {
		v.Set("page", fmt.Sprint(page))
	}
	qs := v.Encode()
	if qs == "" {
		return "/inventory/search"
	}
	return "/inventory/search?" + qs
}

// ---------- Row / Card ----------

templ InventoryRow(row inventory.InventoryRow) {
	<tr id={ "inventory-row-" + fmt.Sprint(row.ProductID) } class="border-t border-zinc-800 hover:bg-zinc-800/40 transition">
		<td class="px-4 py-2 font-mono text-xs text-zinc-300">{ row.SKU }</td>
		<td class="px-4 py-2">
			<div class="font-medium text-white">{ row.Name }</div>
			if row.Brand != "" || row.Category != "" {
				<div class="text-xs text-zinc-500">
					{ row.Brand }
					if row.Brand != "" && row.Category != "" {
						<span class="text-zinc-600"> · </span>
					}
					{ row.Category }
				</div>
			}
		</td>
		<td class="px-4 py-2 text-right tabular-nums text-white font-medium">{ fmt.Sprint(row.CurrentStock) }</td>
		<td class="px-4 py-2 text-right tabular-nums text-zinc-500">{ fmt.Sprint(row.MinimumStock) }</td>
		<td class="px-4 py-2">@stockStatus(row.IsLowStock)</td>
		<td class="px-4 py-2 text-right space-x-2 whitespace-nowrap">
			<button
				type="button"
				hx-get={ "/inventory/receive/" + fmt.Sprint(row.ProductID) }
				hx-target="#modal-root"
				hx-swap="innerHTML"
				class="px-3 py-1.5 text-xs rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide hover:bg-lime-300 active:scale-95 transition"
			>
				Receive
			</button>
			<button
				type="button"
				hx-get={ "/inventory/adjust/" + fmt.Sprint(row.ProductID) }
				hx-target="#modal-root"
				hx-swap="innerHTML"
				class="px-3 py-1.5 text-xs rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white active:scale-95 transition"
			>
				Adjust
			</button>
		</td>
	</tr>
}

templ InventoryCardMobile(row inventory.InventoryRow) {
	<div id={ "inventory-card-" + fmt.Sprint(row.ProductID) } class="px-4 py-3 border-b border-zinc-800 last:border-0">
		<div class="mb-2">
			<div class="font-medium text-white text-sm break-words leading-tight">{ row.Name }</div>
			<div class="text-xs text-zinc-500 font-mono mt-1">{ row.SKU }</div>
		</div>

		<div class="flex items-center justify-between gap-2 mb-3">
			<div class="flex items-center gap-2">
				<span class="text-xs text-zinc-400">Stock:</span>
				<span class="text-sm font-medium text-zinc-200">{ fmt.Sprint(row.CurrentStock) }</span>
				<span class="text-xs text-zinc-500">(Min: { fmt.Sprint(row.MinimumStock) })</span>
			</div>
			@stockStatus(row.IsLowStock)
		</div>

		<div class="flex items-center gap-2">
			<button
				type="button"
				hx-get={ "/inventory/receive/" + fmt.Sprint(row.ProductID) }
				hx-target="#modal-root"
				hx-swap="innerHTML"
				class="min-h-[40px] flex-1 px-3 py-2 text-sm rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide hover:bg-lime-300 active:scale-95 transition"
			>
				Receive
			</button>
			<button
				type="button"
				hx-get={ "/inventory/adjust/" + fmt.Sprint(row.ProductID) }
				hx-target="#modal-root"
				hx-swap="innerHTML"
				class="min-h-[40px] flex-1 px-3 py-2 text-sm rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white active:scale-95 transition"
			>
				Adjust
			</button>
		</div>
	</div>
}

// InventoryTableOOB — returned after a successful receive/adjust.
templ InventoryTableOOB(rows []inventory.InventoryRow) {
	<div id="inventory-results" hx-swap-oob="true">
		@InventoryTableResults(rows, inventory.ListFilter{}, inventory.Page{})
	</div>
	<div id="modal-root" hx-swap-oob="true"></div>
}

templ stockStatus(low bool) {
	if low {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-red-500/10 text-red-500 border border-red-500/30">
			<span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>Low
		</span>
	} else {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-lime-400/10 text-lime-400 border border-lime-400/30">
			<span class="h-1.5 w-1.5 rounded-full bg-lime-400"></span>OK
		</span>
	}
}

// ---------- Receive modal ----------

templ ReceiveModal(row inventory.InventoryRow, suppliers []inventory.Supplier) {
	<div class="modal-backdrop" data-modal>
		<div class="modal-panel">
			<div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between">
				<h2 class="font-display italic uppercase tracking-wider text-lg">Receive Stock</h2>
				<button type="button" onclick="document.getElementById('modal-root').innerHTML=''" class="h-9 w-9 inline-flex items-center justify-center rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-white active:scale-95 transition" aria-label="Close">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			<form hx-post={ "/inventory/receive/" + fmt.Sprint(row.ProductID) } hx-target="#inventory-results" hx-swap="innerHTML" class="p-5 space-y-3">
				<div class="text-sm text-zinc-400 mb-1">
					<div class="font-medium text-white">{ row.Name }</div>
					<div class="text-xs mt-0.5">
						SKU { row.SKU } · current stock <span class="text-zinc-300 tabular-nums">{ fmt.Sprint(row.CurrentStock) }</span>
					</div>
				</div>
				<label class="block">
					<span class="block text-xs font-medium text-zinc-400 mb-1">Quantity <span class="text-red-500">*</span></span>
					<input type="number" name="quantity" min="1" required class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
				</label>
				<label class="block">
					<span class="block text-xs font-medium text-zinc-400 mb-1">Unit cost</span>
					<input type="number" name="unit_cost" step="0.01" min="0" class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
				</label>
				<label class="block">
					<span class="block text-xs font-medium text-zinc-400 mb-1">Supplier</span>
					<select name="supplier_id" class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition">
						<option value="">— none —</option>
						for _, s := range suppliers {
							<option value={ fmt.Sprint(s.ID) }>{ s.Name }</option>
						}
					</select>
				</label>
				<label class="block">
					<span class="block text-xs font-medium text-zinc-400 mb-1">Reference</span>
					<input type="text" name="reference" placeholder="e.g. DR-2025-001" class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
				</label>
				<label class="block">
					<span class="block text-xs font-medium text-zinc-400 mb-1">Notes</span>
					<textarea name="notes" rows="2" class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"></textarea>
				</label>
				<div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
					<button type="button" onclick="document.getElementById('modal-root').innerHTML=''" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-sm active:scale-95 transition">Cancel</button>
					<button type="submit" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition">Receive</button>
				</div>
			</form>
		</div>
	</div>
}

// ---------- Adjust modal ----------

templ AdjustModal(row inventory.InventoryRow) {
	<div class="modal-backdrop" data-modal>
		<div class="modal-panel">
			<div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between">
				<h2 class="font-display italic uppercase tracking-wider text-lg">Adjust Stock</h2>
				<button type="button" onclick="document.getElementById('modal-root').innerHTML=''" class="h-9 w-9 inline-flex items-center justify-center rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-white active:scale-95 transition" aria-label="Close">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			<form hx-post={ "/inventory/adjust/" + fmt.Sprint(row.ProductID) } hx-target="#inventory-results" hx-swap="innerHTML" class="p-5 space-y-3">
				<div class="text-sm text-zinc-400 mb-1">
					<div class="font-medium text-white">{ row.Name }</div>
					<div class="text-xs mt-0.5">
						SKU { row.SKU } · current stock <span class="text-zinc-300 tabular-nums">{ fmt.Sprint(row.CurrentStock) }</span>
					</div>
				</div>
				<label class="block">
					<span class="block text-xs font-medium text-zinc-400 mb-1">New quantity <span class="text-red-500">*</span></span>
					<input type="number" name="new_quantity" min="0" value={ fmt.Sprint(row.CurrentStock) } required class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
					<p class="text-xs text-zinc-500 mt-1">The system will record the difference as an adjustment.</p>
				</label>
				<label class="block">
					<span class="block text-xs font-medium text-zinc-400 mb-1">Reason <span class="text-red-500">*</span></span>
					<textarea name="notes" rows="2" required placeholder="e.g. Damaged units, recount, shrinkage" class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"></textarea>
				</label>
				<div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
					<button type="button" onclick="document.getElementById('modal-root').innerHTML=''" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-sm active:scale-95 transition">Cancel</button>
					<button type="submit" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition">Save Adjustment</button>
				</div>
			</form>
		</div>
	</div>
}

// ---------- Movements table ----------

templ MovementsTable(movements []inventory.Movement) {
	<div id="movements-table" class="bg-zinc-900 border border-zinc-800 rounded-md overflow-hidden">
		<div class="hidden md:block overflow-x-auto">
			<table class="min-w-full text-sm">
				<thead class="bg-zinc-950/60 text-zinc-400">
					<tr>
						<th class="text-left font-medium px-3 py-2">Date</th>
						<th class="text-left font-medium px-3 py-2">Product</th>
						<th class="text-left font-medium px-3 py-2">Type</th>
						<th class="text-right font-medium px-3 py-2">Qty</th>
						<th class="text-right font-medium px-3 py-2">Unit cost</th>
						<th class="text-left font-medium px-3 py-2">Supplier</th>
						<th class="text-left font-medium px-3 py-2">User</th>
						<th class="text-left font-medium px-3 py-2">Reference / Notes</th>
					</tr>
				</thead>
				<tbody>
					if len(movements) == 0 {
						<tr>
							<td colspan="8" class="px-3 py-12 text-center">
								<p class="text-zinc-400 text-sm">No movements found.</p>
							</td>
						</tr>
					}
					for _, m := range movements {
						<tr class="border-t border-zinc-800 hover:bg-zinc-800/40 transition">
							<td class="px-3 py-2 text-zinc-400 text-xs whitespace-nowrap">{ m.MovementDate.Format("2006-01-02 15:04") }</td>
							<td class="px-3 py-2">
								<div class="font-medium text-white">{ m.ProductName }</div>
								<div class="text-xs font-mono text-zinc-500">{ m.SKU }</div>
							</td>
							<td class="px-3 py-2">@movementTypeBadge(m.Type)</td>
							<td class="px-3 py-2 text-right tabular-nums">@movementQty(m.Type, m.Quantity)</td>
							<td class="px-3 py-2 text-right tabular-nums text-zinc-300">
								if m.UnitCost != nil {
									{ fmt.Sprintf("%.2f", *m.UnitCost) }
								} else {
									<span class="text-zinc-600">—</span>
								}
							</td>
							<td class="px-3 py-2 text-zinc-300">{ m.SupplierName }</td>
							<td class="px-3 py-2 text-zinc-300">{ m.Username }</td>
							<td class="px-3 py-2 text-zinc-400">
								if m.Reference != "" {
									<div class="text-xs text-zinc-300 font-mono">{ m.Reference }</div>
								}
								if m.Notes != "" {
									<div class="text-xs text-zinc-500">{ m.Notes }</div>
								}
							</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="md:hidden divide-y divide-zinc-800">
			if len(movements) == 0 {
				<div class="px-6 py-12 text-center">
					<p class="text-zinc-400 text-sm">No movements found.</p>
				</div>
			}
			for _, m := range movements {
				<div class="px-4 py-3">
					<div class="flex items-start justify-between gap-2">
						<div class="min-w-0 flex-1">
							<div class="font-medium text-white truncate">{ m.ProductName }</div>
							<div class="text-xs font-mono text-zinc-500 mt-0.5">{ m.SKU }</div>
							<div class="text-xs text-zinc-500 mt-1">{ m.MovementDate.Format("Jan 02, 3:04 PM") }</div>
						</div>
						<div class="text-right shrink-0">
							<div class="font-display text-base text-white tabular-nums">@movementQty(m.Type, m.Quantity)</div>
							<div class="mt-1">@movementTypeBadge(m.Type)</div>
						</div>
					</div>
					<div class="mt-2 text-xs text-zinc-400 space-y-0.5">
						if m.SupplierName != "" {
							<div>Supplier: <span class="text-zinc-300">{ m.SupplierName }</span></div>
						}
						if m.Username != "" {
							<div>By: <span class="text-zinc-300">{ m.Username }</span></div>
						}
						if m.UnitCost != nil {
							<div>Unit cost: <span class="text-zinc-300 tabular-nums">{ fmt.Sprintf("%.2f", *m.UnitCost) }</span></div>
						}
						if m.Reference != "" {
							<div class="font-mono">Ref: <span class="text-zinc-300">{ m.Reference }</span></div>
						}
						if m.Notes != "" {
							<div class="italic">"{ m.Notes }"</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

templ movementTypeBadge(t string) {
	if t == "in" {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-lime-400/10 text-lime-400 border border-lime-400/30">
			<span class="h-1.5 w-1.5 rounded-full bg-lime-400"></span>in
		</span>
	} else if t == "out" {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-red-500/10 text-red-500 border border-red-500/30">
			<span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>out
		</span>
	} else {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-zinc-800 text-zinc-300 border border-zinc-700">
			<span class="h-1.5 w-1.5 rounded-full bg-zinc-400"></span>adjust
		</span>
	}
}

templ movementQty(t string, q int) {
	if t == "adjust" && q >= 0 {
		<span class="text-lime-400">+{ fmt.Sprint(q) }</span>
	} else if t == "adjust" && q < 0 {
		<span class="text-red-500">{ fmt.Sprint(q) }</span>
	} else {
		<span class="text-zinc-200">{ fmt.Sprint(q) }</span>
	}
}