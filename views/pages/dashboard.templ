package pages

import (
	"fmt"
	"strconv"

	"github.com/jmechavez/vapeshop/internal/auth"
	"github.com/jmechavez/vapeshop/internal/reports"
	"github.com/jmechavez/vapeshop/views/layouts"
)

templ DashboardPage(sess *auth.Session, dash reports.Dashboard) {
	@layouts.Shell(sess, "Dashboard", displayName(sess)) {
		<div class="p-6 space-y-4">
			<div class="flex items-center justify-between">
				<h1 class="text-xl font-semibold">Dashboard</h1>
				<a href="/reports" class="text-sm text-blue-600 hover:underline">View full reports →</a>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-3 gap-3">
				<div class="bg-white border border-gray-200 rounded p-3">
					<div class="text-xs text-gray-500">Sales today</div>
					<div class="text-lg font-semibold mt-1">{ strconv.Itoa(dash.TodaySalesCount) }</div>
				</div>
				<div class="bg-white border border-gray-200 rounded p-3">
					<div class="text-xs text-gray-500">Low-stock products</div>
					<div class="text-lg font-semibold mt-1 text-red-600">{ strconv.Itoa(dash.LowStockCount) }</div>
				</div>
				<div class="bg-white border border-gray-200 rounded p-3">
					<div class="text-xs text-gray-500">Total today</div>
					<div class="text-lg font-semibold mt-1">₱{ fmt.Sprintf("%.2f", dash.TodayPayments.Total()) }</div>
				</div>
			</div>

			<div>
				<h2 class="text-sm font-semibold text-gray-600 mb-2">Collected today by payment method</h2>
				<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
					@paymentCard("Cash", dash.TodayPayments.Cash)
					@paymentCard("GCash", dash.TodayPayments.GCash)
					@paymentCard("Maribank", dash.TodayPayments.Maribank)
					@paymentCard("Bank Transfer", dash.TodayPayments.BankTransfer)
				</div>
			</div>

			<div class="bg-white border border-gray-200 rounded">
				<div class="px-4 py-2 border-b border-gray-200 font-semibold flex items-center justify-between">
					<span>Recent sales</span>
					<a href="/sales" class="text-xs text-blue-600 hover:underline">View all →</a>
				</div>
				if len(dash.RecentSales) == 0 {
					<div class="p-6 text-center text-sm text-gray-500">No sales yet.</div>
				} else {
					<table class="w-full text-sm">
						<thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
							<tr>
								<th class="px-3 py-2">Reference</th>
								<th class="px-3 py-2">Date</th>
								<th class="px-3 py-2">Cashier</th>
								<th class="px-3 py-2 text-right">Items</th>
								<th class="px-3 py-2 text-right">Total</th>
								<th class="px-3 py-2">Payment</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-gray-100">
							for _, s := range dash.RecentSales {
								<tr>
									<td class="px-3 py-2">
										<a
											href={ "/sales/" + strconv.FormatInt(s.ID, 10) }
											class="text-blue-600 hover:underline font-mono text-xs"
										>{ s.Reference }</a>
									</td>
									<td class="px-3 py-2">{ s.SaleDate.Format("2006-01-02 15:04") }</td>
									<td class="px-3 py-2">{ s.CashierName }</td>
									<td class="px-3 py-2 text-right">{ strconv.Itoa(s.ItemCount) }</td>
									<td class="px-3 py-2 text-right">₱{ fmt.Sprintf("%.2f", s.Total) }</td>
									<td class="px-3 py-2">{ s.PaymentMethod }</td>
								</tr>
							}
						</tbody>
					</table>
				}
			</div>
		</div>
	}
}

templ paymentCard(label string, amount float64) {
	<div class="bg-white border border-gray-200 rounded p-3">
		<div class="text-xs text-gray-500">{ label }</div>
		<div class="text-lg font-semibold mt-1">₱{ fmt.Sprintf("%.2f", amount) }</div>
	</div>
}