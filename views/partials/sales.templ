package partials

import (
	"fmt"
	"strconv"

	"github.com/jmechavez/vapeshop/internal/sales"
)

templ SaleSuggestions(saleID int64, products []sales.ProductSuggestion) {
	if len(products) == 0 {
		<div class="p-3 text-sm text-gray-500 border border-gray-200 rounded bg-white">
			No products found.
		</div>
	} else {
		<ul class="divide-y divide-gray-200 border border-gray-200 rounded bg-white">
			for _, p := range products {
				<li>
					if p.CurrentStock <= 0 {
						<div class="w-full px-3 py-2 flex justify-between items-center gap-3 bg-gray-50 text-gray-400 cursor-not-allowed">
							<span class="flex-1 min-w-0">
								<span class="font-mono text-xs">{ p.SKU }</span>
								<span class="ml-2 line-through">{ p.Name }</span>
							</span>
							<span class="text-xs whitespace-nowrap">Out of stock</span>
						</div>
					} else {
						<form method="POST" action={ "/sales/" + strconv.FormatInt(saleID, 10) + "/items" }>
							<input type="hidden" name="product_id" value={ strconv.FormatInt(p.ID, 10) }/>
							<input type="hidden" name="quantity" value="1"/>
							<button
								type="submit"
								class="w-full text-left px-3 py-2 hover:bg-gray-50 flex justify-between items-center gap-3 cursor-pointer"
							>
								<span class="flex-1 min-w-0">
									<span class="font-mono text-xs text-gray-600">{ p.SKU }</span>
									<span class="ml-2">{ p.Name }</span>
								</span>
								<span class="text-xs text-gray-500 whitespace-nowrap">
									₱{ fmt.Sprintf("%.2f", p.SellingPrice) } · stock { strconv.Itoa(p.CurrentStock) }
								</span>
							</button>
						</form>
					}
				</li>
			}
		</ul>
	}
}

templ SaleCart(sale sales.Sale) {
	<div id="cart-panel" class="border border-gray-200 rounded bg-white">
		<div class="px-4 py-2 border-b border-gray-200 flex justify-between items-center">
			<div>
				<span class="font-semibold">Cart</span>
				<span class="text-xs text-gray-500 ml-2 font-mono">{ sale.Reference }</span>
			</div>
			<span class="text-xs text-gray-500">{ strconv.Itoa(sale.ItemCount) } item(s)</span>
		</div>

		if len(sale.Items) == 0 {
			<div class="p-6 text-center text-sm text-gray-500">
				Cart is empty. Search a product above to add it.
			</div>
		} else {
			<table class="w-full text-sm">
				<thead class="bg-gray-50 text-left text-xs uppercase text-gray-500">
					<tr>
						<th class="px-3 py-2">SKU</th>
						<th class="px-3 py-2">Product</th>
						<th class="px-3 py-2 w-24">Qty</th>
						<th class="px-3 py-2 text-right">Unit</th>
						<th class="px-3 py-2 text-right">Subtotal</th>
						<th class="px-3 py-2"></th>
					</tr>
				</thead>
				<tbody class="divide-y divide-gray-100">
					for _, it := range sale.Items {
						<tr>
							<td class="px-3 py-2 font-mono text-xs">{ it.SKU }</td>
							<td class="px-3 py-2">{ it.ProductName }</td>
							<td class="px-3 py-2">
								<input
									type="number"
									name="quantity"
									min="1"
									value={ strconv.Itoa(it.Quantity) }
									class="w-16 border border-gray-300 rounded px-2 py-1 text-sm"
									hx-put={ "/sales/" + strconv.FormatInt(sale.ID, 10) + "/items/" + strconv.FormatInt(it.ID, 10) }
									hx-include="this"
									hx-trigger="change"
									hx-target="#cart-panel"
									hx-swap="outerHTML"
								/>
							</td>
							<td class="px-3 py-2 text-right">₱{ fmt.Sprintf("%.2f", it.UnitPrice) }</td>
							<td class="px-3 py-2 text-right">₱{ fmt.Sprintf("%.2f", it.Subtotal) }</td>
							<td class="px-3 py-2 text-right">
								<button
									type="button"
									class="text-red-600 hover:underline text-xs"
									hx-delete={ "/sales/" + strconv.FormatInt(sale.ID, 10) + "/items/" + strconv.FormatInt(it.ID, 10) }
									hx-confirm="Remove this item?"
									hx-target="#cart-panel"
									hx-swap="outerHTML"
								>Remove</button>
							</td>
						</tr>
					}
				</tbody>
			</table>
		}

		<div class="border-t border-gray-200 px-4 py-3 space-y-2">
			<div class="flex justify-between text-sm">
				<span class="text-gray-600">Subtotal</span>
				<span>₱{ fmt.Sprintf("%.2f", sale.Subtotal) }</span>
			</div>

			<div class="flex justify-between text-sm items-center">
				<span class="text-gray-600">Discount (₱)</span>
				<input
					type="number"
					name="discount"
					min="0"
					step="0.01"
					value={ fmt.Sprintf("%.2f", sale.Discount) }
					class="w-28 border border-gray-300 rounded px-2 py-1 text-sm text-right"
					hx-put={ "/sales/" + strconv.FormatInt(sale.ID, 10) + "/discount" }
					hx-include="this"
					hx-trigger="change"
					hx-target="#cart-panel"
					hx-swap="outerHTML"
				/>
			</div>

			<div class="flex justify-between text-base font-semibold">
				<span>Total</span>
				<span>₱{ fmt.Sprintf("%.2f", sale.Total) }</span>
			</div>

			<div class="flex justify-between text-sm items-center pt-2">
				<span class="text-gray-600">Payment</span>
				<select
					name="payment_method"
					class="border border-gray-300 rounded px-2 py-1 text-sm"
					hx-put={ "/sales/" + strconv.FormatInt(sale.ID, 10) + "/payment" }
					hx-include="this"
					hx-trigger="change"
					hx-target="#cart-panel"
					hx-swap="outerHTML"
				>
					for _, m := range sales.PaymentMethods {
						if m == sale.PaymentMethod {
							<option value={ m } selected>{ m }</option>
						} else {
							<option value={ m }>{ m }</option>
						}
					}
				</select>
			</div>

			<div class="flex flex-wrap gap-2 pt-3">
				<button
					type="button"
					class="px-3 py-2 bg-black text-white rounded text-sm disabled:opacity-50"
					disabled?={ len(sale.Items) == 0 }
					hx-post={ "/sales/" + strconv.FormatInt(sale.ID, 10) + "/complete" }
					hx-confirm="Complete this sale? Stock will be deducted."
				>Complete sale</button>
				<a
					href={ "/sales/" + strconv.FormatInt(sale.ID, 10) }
					class="px-3 py-2 border border-gray-300 rounded text-sm"
				>Save as pending</a>
			</div>
			<p class="text-xs text-gray-500 pt-1">
				The sale stays <strong>pending</strong> until you complete it. Refreshing this page keeps the cart.
			</p>
		</div>
	</div>
}