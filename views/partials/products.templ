package partials

import (
	"fmt"
	"net/url"
	"strconv"

	"github.com/jmechavez/vapeshop/internal/products"
)

templ ProductsTable(list []products.ProductWithStock, q string, page products.Page) {
	<div id="products-table">
		<div class="bg-zinc-900 border border-zinc-800 rounded-md overflow-hidden">
			<div class="hidden md:block overflow-x-auto">
				<table class="min-w-full text-sm">
					<thead class="bg-zinc-950/60 text-zinc-400">
						<tr>
							<th class="text-left font-medium px-4 py-2">SKU</th>
							<th class="text-left font-medium px-4 py-2">Name</th>
							<th class="text-left font-medium px-4 py-2">Brand</th>
							<th class="text-left font-medium px-4 py-2">Flavor</th>
							<th class="text-right font-medium px-4 py-2">Price</th>
							<th class="text-right font-medium px-4 py-2">Stock</th>
							<th class="px-4 py-2"></th>
						</tr>
					</thead>
					<tbody>
						if len(list) == 0 {
							<tr>
								<td colspan="7" class="px-4 py-12 text-center">
									<p class="text-zinc-400 text-sm">
										if q != "" {
											No products match "{q}".
										} else {
											No products yet.
										}
									</p>
								</td>
							</tr>
						}
						for _, p := range list {
							@ProductRow(p)
						}
					</tbody>
				</table>
			</div>
			
			<div class="md:hidden divide-y divide-zinc-800">
				if len(list) == 0 {
					<div class="px-6 py-12 text-center">
						<p class="text-zinc-400 text-sm">
							if q != "" {
								No products match "{q}".
							} else {
								No products yet.
							}
						</p>
					</div>
				}
				for _, p := range list {
					@ProductCardMobile(p)
				}
			</div>
		</div>
		if page.Total > 0 {
			@ProductsPagination(q, page)
		}
	</div>
}

templ ProductsPagination(q string, page products.Page) {
	<div class="flex flex-col sm:flex-row items-center justify-between gap-3 px-4 py-3 border-t border-zinc-800 bg-zinc-950/40 text-sm">
		<div class="text-zinc-400 tabular-nums">
			Showing <span class="text-zinc-200">{fmt.Sprint(page.From())}</span>–<span class="text-zinc-200">{fmt.Sprint(page.To())}</span> of <span class="text-zinc-200">{fmt.Sprint(page.Total)}</span>
		</div>
		<div class="flex items-center gap-1">
			<button type="button" class="min-h-[36px] px-3 py-1.5 rounded-sm border border-zinc-800 text-zinc-300 hover:border-zinc-700 hover:text-white active:scale-95 transition" hx-get={productsPageURL(q, page.Page-1)} hx-target="#products-table" hx-swap="outerHTML" hx-push-url="true">‹ Prev</button>
			<span class="px-3 text-zinc-400 tabular-nums">Page <span class="text-zinc-200">{fmt.Sprint(page.Page)}</span> of <span class="text-zinc-200">{fmt.Sprint(page.TotalPages())}</span></span>
			<button type="button" class="min-h-[36px] px-3 py-1.5 rounded-sm border border-zinc-800 text-zinc-300 hover:border-zinc-700 hover:text-white active:scale-95 transition" hx-get={productsPageURL(q, page.Page+1)} hx-target="#products-table" hx-swap="outerHTML" hx-push-url="true">Next ›</button>
		</div>
	</div>
}

func productsPageURL(q string, page int) string {
	if page < 1 {
		page = 1
	}
	v := url.Values{}
	if q != "" {
		v.Set("q", q)
	}
	if page > 1 {
		v.Set("page", fmt.Sprint(page))
	}
	qs := v.Encode()
	if qs == "" {
		return "/products/search"
	}
	return "/products/search?" + qs
}

templ ProductsTableOOB(list []products.ProductWithStock) {
	@ProductsTable(list, "", products.Page{Page: 1, PerPage: 25, Total: len(list)})
	<div id="modal" hx-swap-oob="true"></div>
}

templ ProductRow(p products.ProductWithStock) {
	<tr id={"product-row-" + strconv.FormatInt(p.ID, 10)} class="border-t border-zinc-800 hover:bg-zinc-800/40 transition">
		<td class="px-4 py-2 font-mono text-xs text-zinc-300">{p.SKU}</td>
		<td class="px-4 py-2">
			<div class="font-medium text-white">{p.Name}</div>
			if p.Version != "" {
				<div class="text-xs text-zinc-500">{p.Version}</div>
			}
		</td>
		<td class="px-4 py-2 text-zinc-300">{p.Brand}</td>
		<td class="px-4 py-2 text-zinc-300">{p.Flavor}</td>
		<td class="px-4 py-2 text-right text-lime-400 font-medium">{money(p.SellingPrice)}</td>
		<td class="px-4 py-2 text-right">
			@stockBadge(p.CurrentStock, p.MinimumStock)
		</td>
		<td class="px-4 py-2 text-right whitespace-nowrap">
			<button hx-get={"/products/" + strconv.FormatInt(p.ID, 10) + "/edit"} hx-target={"#product-row-" + strconv.FormatInt(p.ID, 10)} hx-swap="outerHTML" class="px-3 py-1.5 text-xs rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white active:scale-95 transition mr-2">Edit</button>
			<button type="button"
				data-confirm="yes"
				data-title="Delete Product"
				data-message={"Delete " + p.Name + "?"}
				data-confirm-text="Delete"
				data-destructive="true"
				data-method="DELETE"
				data-url={"/products/" + strconv.FormatInt(p.ID, 10)}
				data-target={"#product-row-" + strconv.FormatInt(p.ID, 10)}
				class="px-3 py-1.5 text-xs rounded-sm border border-red-500/40 text-red-500 hover:bg-red-500/10 active:scale-95 transition">Delete</button>
		</td>
	</tr>
}

templ ProductCardMobile(p products.ProductWithStock) {
	<div id={"product-row-" + strconv.FormatInt(p.ID, 10)} class="px-4 py-3">
		<div class="flex items-start justify-between gap-2">
			<div class="min-w-0 flex-1">
				<div class="font-medium text-white truncate">{p.Name}</div>
				<div class="text-xs text-zinc-500 font-mono mt-0.5">{p.SKU}</div>
			</div>
			<div class="text-right shrink-0">
				<div class="text-lime-400 font-display text-base">{money(p.SellingPrice)}</div>
				<div class="mt-1">
					@stockBadge(p.CurrentStock, p.MinimumStock)
				</div>
			</div>
		</div>
		<div class="mt-3 flex items-center gap-2">
			<button hx-get={"/products/" + strconv.FormatInt(p.ID, 10) + "/edit-modal"} hx-target="#modal" hx-swap="innerHTML" class="min-h-[40px] flex-1 px-3 py-2 text-sm rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white active:scale-95 transition">Edit</button>
			<button type="button"
				data-confirm="yes"
				data-title="Delete Product"
				data-message={"Delete " + p.Name + "?"}
				data-confirm-text="Delete"
				data-destructive="true"
				data-method="DELETE"
				data-url={"/products/" + strconv.FormatInt(p.ID, 10)}
				data-target={"#product-row-" + strconv.FormatInt(p.ID, 10)}
				class="min-h-[40px] px-3 py-2 text-sm rounded-sm border border-red-500/40 text-red-500 hover:bg-red-500/10 active:scale-95 transition">Delete</button>
		</div>
	</div>
}

templ stockBadge(current, minimum int) {
	if current <= minimum {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-red-500/10 text-red-500 border border-red-500/30">
			<span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>
			{strconv.Itoa(current)}
		</span>
	} else {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-zinc-800 text-zinc-300 border border-zinc-700">
			{strconv.Itoa(current)}
		</span>
	}
}

templ ProductRowEdit(p products.ProductWithStock, errMsg string) {
	<tr id={"product-row-" + strconv.FormatInt(p.ID, 10)} class="border-t border-zinc-800 bg-lime-400/5">
		<!-- Hidden fields to prevent data loss during inline edit -->
		<input type="hidden" name="barcode" value={p.Barcode}/>
		<input type="hidden" name="version" value={p.Version}/>
		<input type="hidden" name="category" value={p.Category}/>
		<input type="hidden" name="cost_price" value={formatFloat(p.CostPrice)}/>
		<input type="hidden" name="minimum_stock" value={strconv.Itoa(p.MinimumStock)}/>

		<td class="px-3 py-2">
			<input name="sku" value={p.SKU} required class="w-28 px-2 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30"/>
		</td>
		<td class="px-3 py-2">
			<input name="name" value={p.Name} required class="w-full min-w-[10rem] px-2 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30"/>
			if errMsg != "" {
				<div class="text-xs text-red-500 mt-1">{errMsg}</div>
			}
		</td>
		<td class="px-3 py-2">
			<input name="brand" value={p.Brand} class="w-24 px-2 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30"/>
		</td>
		<td class="px-3 py-2">
			<input name="flavor" value={p.Flavor} class="w-24 px-2 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30"/>
		</td>
		<td class="px-3 py-2 text-right">
			<input name="selling_price" type="number" step="0.01" min="0" value={formatFloat(p.SellingPrice)} class="w-24 px-2 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white text-right focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30"/>
		</td>
		<td class="px-3 py-2 text-right text-zinc-500 text-sm">
			{strconv.Itoa(p.CurrentStock)}
		</td>
		<td class="px-3 py-2 text-right whitespace-nowrap">
			<button hx-put={"/products/" + strconv.FormatInt(p.ID, 10)} hx-include="closest tr" hx-target={"#product-row-" + strconv.FormatInt(p.ID, 10)} hx-swap="outerHTML" class="px-3 py-1.5 text-xs rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide hover:bg-lime-300 active:scale-95 transition mr-2">Save</button>
			<button hx-get={"/products/" + strconv.FormatInt(p.ID, 10) + "/row"} hx-target={"#product-row-" + strconv.FormatInt(p.ID, 10)} hx-swap="outerHTML" class="px-3 py-1.5 text-xs rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white active:scale-95 transition">Cancel</button>
		</td>
	</tr>
}

templ ProductFormModal(p products.Product, errMsg string) {
	<div id="product-modal" class="modal-backdrop" data-modal>
		<div class="modal-panel">
			<div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between">
				<h2 class="font-display italic uppercase tracking-wider text-lg">Add Product</h2>
				<button type="button" onclick="closeModal('product-modal')" class="h-9 w-9 inline-flex items-center justify-center rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-white active:scale-95 transition" aria-label="Close">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="18" y1="6" x2="6" y2="18"></line> <line x1="6" y1="6" x2="18" y2="18"></line></svg>
				</button>
			</div>
			<form hx-post="/products" hx-target="#products-table" hx-swap="outerHTML" class="p-5 space-y-4">
				if errMsg != "" {
					<div class="px-3 py-2 rounded-sm bg-red-500/10 border border-red-500/40 text-red-500 text-sm">{errMsg}</div>
				}
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					@textField("sku", "SKU *", p.SKU)
					@textField("barcode", "Barcode", p.Barcode)
					@textField("name", "Name *", p.Name)
					@textField("brand", "Brand", p.Brand)
					@textField("version", "Version", p.Version)
					@textField("flavor", "Flavor", p.Flavor)
					@textField("category", "Category", p.Category)
					@numberField("cost_price", "Cost price", p.CostPrice)
					@numberField("selling_price", "Selling price", p.SellingPrice)
					@intField("minimum_stock", "Minimum stock", p.MinimumStock)
				</div>
				<div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
					<button type="button" onclick="closeModal('product-modal')" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-sm active:scale-95 transition">Cancel</button>
					<button type="submit" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition">Save Product</button>
				</div>
			</form>
		</div>
	</div>
}

templ ProductEditModal(p products.Product) {
	<div id="product-edit-modal" class="modal-backdrop" data-modal>
		<div class="modal-panel">
			<div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between">
				<h2 class="font-display italic uppercase tracking-wider text-lg">Edit Product</h2>
				<button type="button" onclick="closeModal('product-edit-modal')" class="h-9 w-9 inline-flex items-center justify-center rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-white active:scale-95 transition" aria-label="Close">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="18" y1="6" x2="6" y2="18"></line> <line x1="6" y1="6" x2="18" y2="18"></line></svg>
				</button>
			</div>
			<form hx-put={"/products/" + strconv.FormatInt(p.ID, 10)} hx-target={"#product-row-" + strconv.FormatInt(p.ID, 10)} hx-swap="outerHTML" class="p-5 space-y-4">
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					@textField("sku", "SKU *", p.SKU)
					@textField("barcode", "Barcode", p.Barcode)
					@textField("name", "Name *", p.Name)
					@textField("brand", "Brand", p.Brand)
					@textField("version", "Version", p.Version)
					@textField("flavor", "Flavor", p.Flavor)
					@textField("category", "Category", p.Category)
					@numberField("cost_price", "Cost price", p.CostPrice)
					@numberField("selling_price", "Selling price", p.SellingPrice)
					@intField("minimum_stock", "Minimum stock", p.MinimumStock)
				</div>
				<div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
					<button type="button" onclick="closeModal('product-edit-modal')" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-sm active:scale-95 transition">Cancel</button>
					<button type="submit" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition">Save Changes</button>
				</div>
			</form>
		</div>
	</div>
}

templ ProductsTableWithImportReport(list []products.ProductWithStock, created int, failed []string) {
	@ProductsTable(list, "", products.Page{Page: 1, PerPage: 25, Total: len(list)})
	if created > 0 || len(failed) > 0 {
		<div class="mt-4 p-4 rounded-md bg-zinc-900 border border-zinc-800 text-sm">
			if created > 0 {
				<div class="flex items-center gap-2 text-emerald-500">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4 shrink-0"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path> <polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
					<span>Imported {strconv.Itoa(created)} product(s).</span>
				</div>
			}
			if len(failed) > 0 {
				<ul class="mt-3 space-y-1 text-red-500 list-disc pl-5">
					for _, f := range failed {
						<li>{f}</li>
					}
				</ul>
			}
		</div>
	}
	<div id="modal" hx-swap-oob="true"></div>
}

templ textField(name, label, value string) {
	<label class="block">
		<span class="block text-xs font-medium text-zinc-400 mb-1">{label}</span>
		<input name={name} value={value} class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
	</label>
}

templ numberField(name, label string, value float64) {
	<label class="block">
		<span class="block text-xs font-medium text-zinc-400 mb-1">{label}</span>
		<input name={name} type="number" step="0.01" min="0" value={formatFloat(value)} class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
	</label>
}

templ intField(name, label string, value int) {
	<label class="block">
		<span class="block text-xs font-medium text-zinc-400 mb-1">{label}</span>
		<input name={name} type="number" min="0" value={strconv.Itoa(value)} class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
	</label>
}

func money(v float64) string {
	return "PHP " + formatFloat(v)
}

func formatFloat(v float64) string {
	return strconv.FormatFloat(v, 'f', 2, 64)
}