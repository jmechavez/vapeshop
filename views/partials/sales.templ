package partials

import (
	"fmt"
	"strconv"
	"time"

	"github.com/jmechavez/vapeshop/internal/sales"
)

templ SaleSuggestions(saleID int64, products []sales.ProductSuggestion) {
	if len(products) == 0 {
		<div class="p-3 text-sm text-zinc-400 bg-zinc-900 border border-zinc-800 rounded-md">No products found.</div>
	} else {
		<ul class="divide-y divide-zinc-800 bg-zinc-900 border border-zinc-800 rounded-md overflow-hidden">
			for _, p := range products {
				<li>
					if p.CurrentStock <= 0 {
						<div class="w-full px-3 py-3 sm:py-2 flex justify-between items-center gap-3 bg-zinc-950/60 text-zinc-500 cursor-not-allowed">
							<span class="flex-1 min-w-0">
								<span class="font-mono text-xs text-zinc-500">{p.SKU}</span>
								<span class="ml-2 line-through">{p.Name}</span>
							</span>
							<span class="text-[10px] uppercase tracking-wide px-2 py-0.5 rounded-sm bg-red-500/10 text-red-500 border border-red-500/30 whitespace-nowrap">Out of stock</span>
						</div>
					} else {
						<form method="POST" action={ templ.SafeURL("/sales/" + strconv.FormatInt(saleID, 10) + "/items") }>
							<input type="hidden" name="product_id" value={strconv.FormatInt(p.ID, 10)}/>
							<input type="hidden" name="quantity" value="1"/>
							<button type="submit" class="w-full text-left px-3 py-3 sm:py-2 hover:bg-zinc-800/60 active:bg-zinc-800 flex justify-between items-center gap-3 cursor-pointer transition">
								<span class="flex-1 min-w-0">
									<span class="font-mono text-xs text-zinc-500">{p.SKU}</span>
									<span class="ml-2 text-zinc-100">{p.Name}</span>
								</span>
								<span class="text-xs whitespace-nowrap">
									<span class="text-lime-400 font-medium tabular-nums">₱{fmt.Sprintf("%.2f", p.SellingPrice)}</span>
									<span class="text-zinc-500"> · stock </span>
									<span class="text-zinc-300 tabular-nums">{strconv.Itoa(p.CurrentStock)}</span>
								</span>
							</button>
						</form>
					}
				</li>
			}
		</ul>
	}
}

templ SaleCart(sale sales.Sale) {
	<div id="cart-panel" class="bg-zinc-900 border border-zinc-800 rounded-md overflow-hidden lg:sticky lg:top-6">
		<div class="px-4 py-3 border-b border-zinc-800 flex items-center justify-between gap-2">
			<div class="min-w-0">
				<div class="font-display italic uppercase tracking-wider text-base text-white">Cart</div>
				<div class="text-xs text-zinc-500 font-mono truncate">{sale.Reference}</div>
			</div>
			<span class="text-xs text-zinc-400 whitespace-nowrap">{strconv.Itoa(sale.ItemCount)} item(s)</span>
		</div>

		if len(sale.Items) == 0 {
			<div class="px-6 py-10 text-center text-sm text-zinc-400">Cart is empty. Search a product above to add it.</div>
		} else {
			<div class="hidden md:block overflow-x-auto">
				<table class="min-w-full text-sm">
					<thead class="bg-zinc-950/60 text-zinc-400">
						<tr>
							<th class="text-left font-medium px-3 py-2">SKU</th>
							<th class="text-left font-medium px-3 py-2">Product</th>
							<th class="text-left font-medium px-3 py-2 w-24">Qty</th>
							<th class="text-right font-medium px-3 py-2">Unit</th>
							<th class="text-right font-medium px-3 py-2">Subtotal</th>
							<th class="px-3 py-2"></th>
						</tr>
					</thead>
					<tbody>
						for _, it := range sale.Items {
							<tr class="border-t border-zinc-800">
								<td class="px-3 py-2 font-mono text-xs text-zinc-300">{it.SKU}</td>
								<td class="px-3 py-2 text-zinc-200">{it.ProductName}</td>
								<td class="px-3 py-2">
									<input
										type="number"
										name="quantity"
										min="1"
										value={strconv.Itoa(it.Quantity)}
										class="w-16 text-base px-2 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"
										hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/items/" + strconv.FormatInt(it.ID, 10)}
										hx-include="this"
										hx-trigger="change"
										hx-target="#cart-panel"
										hx-swap="outerHTML"
									/>
								</td>
								<td class="px-3 py-2 text-right text-zinc-300 tabular-nums">₱{fmt.Sprintf("%.2f", it.UnitPrice)}</td>
								<td class="px-3 py-2 text-right text-lime-400 font-medium tabular-nums">₱{fmt.Sprintf("%.2f", it.Subtotal)}</td>
								<td class="px-3 py-2 text-right">
									<button
										type="button"
										data-confirm="yes"
										data-title="Remove Item"
										data-message={"Remove " + it.ProductName + " from cart?"}
										data-confirm-text="Remove"
										data-destructive="true"
										data-method="DELETE"
										data-url={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/items/" + strconv.FormatInt(it.ID, 10)}
										data-target="#cart-panel"
										class="h-8 w-8 inline-flex items-center justify-center rounded-sm border border-red-500/40 text-red-500 hover:bg-red-500/10 active:scale-95 transition"
										aria-label="Remove item"
									>
										<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4"><line x1="18" y1="6" x2="6" y2="18"></line> <line x1="6" y1="6" x2="18" y2="18"></line></svg>
									</button>
								</td>
							</tr>
						}
					</tbody>
				</table>
			</div>
			<div class="md:hidden divide-y divide-zinc-800">
				for _, it := range sale.Items {
					<div class="px-4 py-3">
						<div class="flex items-start justify-between gap-2">
							<div class="min-w-0 flex-1">
								<div class="font-medium text-white truncate">{it.ProductName}</div>
								<div class="text-xs font-mono text-zinc-500 mt-0.5">{it.SKU}</div>
							</div>
							<div class="text-right shrink-0">
								<div class="text-lime-400 font-display text-base tabular-nums">₱{fmt.Sprintf("%.2f", it.Subtotal)}</div>
								<div class="text-xs text-zinc-500 tabular-nums">₱{fmt.Sprintf("%.2f", it.UnitPrice)} each</div>
							</div>
						</div>
						<div class="mt-3 flex items-center gap-2">
							<input
								type="number"
								name="quantity"
								min="1"
								value={strconv.Itoa(it.Quantity)}
								class="w-20 text-base px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white text-center focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"
								hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/items/" + strconv.FormatInt(it.ID, 10)}
								hx-include="this"
								hx-trigger="change"
								hx-target="#cart-panel"
								hx-swap="outerHTML"
							/>
							<button
								type="button"
								data-confirm="yes"
								data-title="Remove Item"
								data-message={"Remove " + it.ProductName + " from cart?"}
								data-confirm-text="Remove"
								data-destructive="true"
								data-method="DELETE"
								data-url={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/items/" + strconv.FormatInt(it.ID, 10)}
								data-target="#cart-panel"
								class="min-h-[40px] ml-auto inline-flex items-center justify-center gap-2 px-3 py-2 rounded-sm border border-red-500/40 text-red-500 hover:bg-red-500/10 active:scale-95 transition text-sm"
							>Remove</button>
						</div>
					</div>
				}
			</div>
		}

		<div class="border-t border-zinc-800 px-4 py-4 space-y-3">
			<div class="flex justify-between text-sm">
				<span class="text-zinc-400">Subtotal</span>
				<span class="text-zinc-200 tabular-nums">₱{fmt.Sprintf("%.2f", sale.Subtotal)}</span>
			</div>
			<div class="flex justify-between items-center text-sm gap-3">
				<span class="text-zinc-400">Discount (₱)</span>
				<input
					type="number"
					name="discount"
					min="0"
					step="0.01"
					value={fmt.Sprintf("%.2f", sale.Discount)}
					class="w-28 text-base px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white text-right focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"
					hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/discount"}
					hx-include="this"
					hx-trigger="change"
					hx-target="#cart-panel"
					hx-swap="outerHTML"
				/>
			</div>

			<!-- QUICK DISCOUNT BUTTONS -->
			<div class="flex gap-2">
				<button
					type="button"
					hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/discount"}
					hx-vals='{"discount": "50"}'
					hx-target="#cart-panel"
					hx-swap="outerHTML"
					class="flex-1 min-h-[40px] py-2 text-sm font-medium rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 active:scale-95 transition flex items-center justify-center"
				>₱50</button>
				<button
					type="button"
					hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/discount"}
					hx-vals='{"discount": "100"}'
					hx-target="#cart-panel"
					hx-swap="outerHTML"
					class="flex-1 min-h-[40px] py-2 text-sm font-medium rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 active:scale-95 transition flex items-center justify-center"
				>₱100</button>
				<button
					type="button"
					hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/discount"}
					hx-vals={"{\"discount\": \"" + fmt.Sprintf("%.2f", sale.Subtotal) + "\"}"}
					hx-target="#cart-panel"
					hx-swap="outerHTML"
					class="flex-1 min-h-[40px] py-2 text-sm font-medium rounded-sm border border-red-500/40 text-red-500 hover:bg-red-500/10 active:scale-95 transition flex items-center justify-center"
				>Free</button>
			</div>

			<div class="flex justify-between text-base border-t border-zinc-800 pt-3">
				<span class="font-display uppercase tracking-wide text-zinc-200">Total</span>
				<span class="font-display text-xl text-lime-400 tabular-nums">₱{fmt.Sprintf("%.2f", sale.Total)}</span>
			</div>

			<!-- TRUE SPLIT PAYMENT SECTION -->
			<div class="space-y-2 border-t border-zinc-800 pt-3">
				<div class="text-xs font-medium text-zinc-400">Payment Breakdown</div>
				<div class="flex items-center justify-between gap-2">
					<label class="text-sm text-zinc-300">Cash</label>
					<input
						type="number"
						name="amount_cash"
						step="0.01"
						min="0"
						placeholder="0.00"
						value={func() string {
							for _, p := range sale.Payments {
								if p.Method == "Cash" {
									return fmt.Sprintf("%.2f", p.Amount)
								}
							}
							return ""
						}()}
						class="w-24 px-2 py-1.5 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white text-right focus:outline-none focus:border-lime-400"
						hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/split-payments"}
						hx-trigger="change"
						hx-include="closest .space-y-2"
						hx-target="#cart-panel"
						hx-swap="outerHTML"
					/>
				</div>
				<div class="flex items-center justify-between gap-2">
					<label class="text-sm text-zinc-300">GCash</label>
					<input
						type="number"
						name="amount_gcash"
						step="0.01"
						min="0"
						placeholder="0.00"
						value={func() string {
							for _, p := range sale.Payments {
								if p.Method == "GCash" {
									return fmt.Sprintf("%.2f", p.Amount)
								}
							}
							return ""
						}()}
						class="w-24 px-2 py-1.5 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white text-right focus:outline-none focus:border-lime-400"
						hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/split-payments"}
						hx-trigger="change"
						hx-include="closest .space-y-2"
						hx-target="#cart-panel"
						hx-swap="outerHTML"
					/>
				</div>
				<div class="flex items-center justify-between gap-2">
					<label class="text-sm text-zinc-300">Maribank</label>
					<input
						type="number"
						name="amount_maribank"
						step="0.01"
						min="0"
						placeholder="0.00"
						value={func() string {
							for _, p := range sale.Payments {
								if p.Method == "Maribank" {
									return fmt.Sprintf("%.2f", p.Amount)
								}
							}
							return ""
						}()}
						class="w-24 px-2 py-1.5 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white text-right focus:outline-none focus:border-lime-400"
						hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/split-payments"}
						hx-trigger="change"
						hx-include="closest .space-y-2"
						hx-target="#cart-panel"
						hx-swap="outerHTML"
					/>
				</div>
				<div class="flex items-center justify-between gap-2">
					<label class="text-sm text-zinc-300">Bank Transfer</label>
					<input
						type="number"
						name="amount_bank"
						step="0.01"
						min="0"
						placeholder="0.00"
						value={func() string {
							for _, p := range sale.Payments {
								if p.Method == "Bank Transfer" {
									return fmt.Sprintf("%.2f", p.Amount)
								}
							}
							return ""
						}()}
						class="w-24 px-2 py-1.5 bg-zinc-950 border border-zinc-800 rounded-sm text-sm text-white text-right focus:outline-none focus:border-lime-400"
						hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/split-payments"}
						hx-trigger="change"
						hx-include="closest .space-y-2"
						hx-target="#cart-panel"
						hx-swap="outerHTML"
					/>
				</div>
				<button
					type="button"
					hx-put={"/sales/" + strconv.FormatInt(sale.ID, 10) + "/split-payments"}
					hx-vals={"{\"amount_cash\": \"" + fmt.Sprintf("%.2f", sale.Total) + "\", \"amount_gcash\": \"0\", \"amount_maribank\": \"0\", \"amount_bank\": \"0\"}"}
					hx-target="#cart-panel"
					hx-swap="outerHTML"
					class="w-full min-h-[44px] py-2 text-sm font-medium rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 active:scale-95 transition"
				>Pay Full in Cash</button>
			</div>

			<!-- COMPLETE FORM -->
			<form 
				hx-post={ "/sales/" + strconv.FormatInt(sale.ID, 10) + "/complete" } 
				hx-include="closest #cart-panel" 
				hx-target="body"
				hx-swap="none"
				class="flex flex-col pt-3 border-t border-zinc-800 m-0"
			>
				<!-- SALE DATE (For backdating) -->
				<div class="flex justify-between items-center text-sm gap-3 mb-3">
					<span class="text-zinc-400">Sale Date</span>
					<input
						type="date"
						name="sale_date"
						value={formatPHDate(sale.SaleDate)}
						class="text-base px-3 py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400"
					/>
				</div>
				<div class="flex flex-col sm:flex-row gap-2">
					<button
						type="submit"
						class={ "min-h-[44px] w-full inline-flex items-center justify-center gap-2 px-4 py-3 sm:py-2 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition", templ.KV("opacity-40 cursor-not-allowed", len(sale.Items) == 0) }
						disabled?={ len(sale.Items) == 0 }
					>Complete sale</button>
					<a href={ templ.SafeURL("/sales/" + strconv.FormatInt(sale.ID, 10)) } class="min-h-[44px] inline-flex items-center justify-center px-4 py-3 sm:py-2 rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-sm font-medium active:scale-95 transition">View detail</a>
				</div>
			</form>
			<p class="text-xs text-zinc-500 pt-1">The sale stays <span class="text-zinc-300 font-medium">pending</span> until you complete it. Refreshing this page keeps the cart.</p>
		</div>
	</div>
}

// --- ADDED TIMEZONE HELPER ---
func formatPHDate(t time.Time) string {
	loc, _ := time.LoadLocation("Asia/Manila")
	return t.In(loc).Format("2006-01-02")
}