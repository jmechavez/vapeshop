// views/partials/suppliers.templ
package partials

import (
	"fmt"

	"github.com/jmechavez/vapeshop/internal/suppliers"
)

// ---------- Suppliers table ----------

templ SuppliersTable(list []suppliers.SupplierWithStats) {
	<div id="suppliers-table" class="bg-white border border-slate-200 rounded-lg overflow-hidden">
		<table class="w-full text-sm">
			<thead class="bg-slate-50 text-slate-600">
				<tr>
					<th class="text-left px-4 py-2 font-medium">Name</th>
					<th class="text-left px-4 py-2 font-medium">Contact</th>
					<th class="text-left px-4 py-2 font-medium">Phone</th>
					<th class="text-left px-4 py-2 font-medium">Email</th>
					<th class="text-right px-4 py-2 font-medium">Movements</th>
					<th class="text-left px-4 py-2 font-medium">Last activity</th>
					<th class="text-right px-4 py-2 font-medium">Actions</th>
				</tr>
			</thead>
			<tbody id="supplier-rows" class="divide-y divide-slate-100">
				if len(list) == 0 {
					<tr>
						<td colspan="7" class="px-4 py-6 text-center text-slate-500">No suppliers yet.</td>
					</tr>
				}
				for _, s := range list {
					@SupplierRow(s)
				}
			</tbody>
		</table>
	</div>
}

// SupplierRow is one <tr> with id="supplier-row-{id}".
templ SupplierRow(s suppliers.SupplierWithStats) {
	<tr id={ "supplier-row-" + fmt.Sprint(s.ID) }>
		<td class="px-4 py-2">
			<a href={ templ.SafeURL("/suppliers/" + fmt.Sprint(s.ID)) } class="font-medium text-slate-800 hover:underline">
				{ s.Name }
			</a>
		</td>
		<td class="px-4 py-2 text-slate-600">
			if s.ContactPerson != "" {
				{ s.ContactPerson }
			} else {
				<span class="text-slate-400">—</span>
			}
		</td>
		<td class="px-4 py-2 text-slate-600">
			if s.Phone != "" {
				{ s.Phone }
			} else {
				<span class="text-slate-400">—</span>
			}
		</td>
		<td class="px-4 py-2 text-slate-600">
			if s.Email != "" {
				{ s.Email }
			} else {
				<span class="text-slate-400">—</span>
			}
		</td>
		<td class="px-4 py-2 text-right tabular-nums text-slate-700">
			{ fmt.Sprint(s.MovementCount) }
		</td>
		<td class="px-4 py-2 text-slate-600">
			if s.LastMovement != nil {
				{ s.LastMovement.Format("2006-01-02 15:04") }
			} else {
				<span class="text-slate-400">—</span>
			}
		</td>
		<td class="px-4 py-2 text-right space-x-2 whitespace-nowrap">
			<button
				hx-get={ "/suppliers/" + fmt.Sprint(s.ID) + "/edit" }
				hx-target="#modal-root"
				hx-swap="innerHTML"
				class="px-2 py-1 text-xs rounded-md bg-slate-700 text-white hover:bg-slate-600"
			>
				Edit
			</button>
			<button
				hx-delete={ "/suppliers/" + fmt.Sprint(s.ID) }
				hx-target={ "#supplier-row-" + fmt.Sprint(s.ID) }
				hx-swap="outerHTML swap:200ms"
				hx-confirm={ "Delete supplier \"" + s.Name + "\"? This cannot be undone." }
				hx-on::after-request="handleSupplierDelete(event)"
				class="px-2 py-1 text-xs rounded-md bg-rose-600 text-white hover:bg-rose-500"
			>
				Delete
			</button>
		</td>
	</tr>
}

// ---------- New modal ----------

templ SupplierNewModal(in suppliers.Input, errMsg string) {
	<div class="fixed inset-0 z-40 flex items-center justify-center bg-black/40">
		<div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4">
			<div class="flex items-center justify-between px-5 py-3 border-b border-slate-200">
				<h2 class="text-base font-semibold text-slate-800">New supplier</h2>
				<button
					type="button"
					onclick="document.getElementById('modal-root').innerHTML=''"
					class="text-slate-400 hover:text-slate-700 text-xl leading-none"
				>&times;</button>
			</div>

			if errMsg != "" {
				<div class="mx-5 mt-4 px-3 py-2 rounded-md bg-rose-50 text-rose-700 text-sm">{ errMsg }</div>
			}

			<form
				hx-post="/suppliers"
				hx-target="#suppliers-table"
				hx-swap="outerHTML"
				hx-on::after-request="if(event.detail.successful) document.getElementById('modal-root').innerHTML=''"
				class="px-5 py-4 space-y-3"
			>
				<div>
					<label class="block text-xs font-medium text-slate-600 mb-1">Name <span class="text-red-500">*</span></label>
					<input type="text" name="name" value={ in.Name } required
						class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-600 mb-1">Contact person</label>
					<input type="text" name="contact_person" value={ in.ContactPerson }
						class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm"/>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<div>
						<label class="block text-xs font-medium text-slate-600 mb-1">Phone</label>
						<input type="text" name="phone" value={ in.Phone }
							class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-600 mb-1">Email</label>
						<input type="email" name="email" value={ in.Email }
							class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm"/>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-600 mb-1">Address</label>
					<textarea name="address" rows="2"
						class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm">{ in.Address }</textarea>
				</div>

				<div class="flex justify-end gap-2 pt-2">
					<button type="button"
						onclick="document.getElementById('modal-root').innerHTML=''"
						class="px-3 py-1.5 text-sm rounded-md border border-slate-300 hover:bg-slate-50"
					>Cancel</button>
					<button type="submit"
						class="px-3 py-1.5 text-sm rounded-md bg-slate-800 text-white hover:bg-slate-700"
					>Create</button>
				</div>
			</form>
		</div>
	</div>
}

// ---------- Edit modal ----------

templ SupplierEditModal(s suppliers.Supplier, errMsg string) {
	<div class="fixed inset-0 z-40 flex items-center justify-center bg-black/40">
		<div class="bg-white rounded-lg shadow-xl w-full max-w-lg mx-4">
			<div class="flex items-center justify-between px-5 py-3 border-b border-slate-200">
				<h2 class="text-base font-semibold text-slate-800">Edit supplier</h2>
				<button
					type="button"
					onclick="document.getElementById('modal-root').innerHTML=''"
					class="text-slate-400 hover:text-slate-700 text-xl leading-none"
				>&times;</button>
			</div>

			if errMsg != "" {
				<div class="mx-5 mt-4 px-3 py-2 rounded-md bg-rose-50 text-rose-700 text-sm">{ errMsg }</div>
			}

			<form
				hx-put={ "/suppliers/" + fmt.Sprint(s.ID) }
				hx-target={ "#supplier-row-" + fmt.Sprint(s.ID) }
				hx-swap="outerHTML"
				hx-on::after-request="if(event.detail.successful) document.getElementById('modal-root').innerHTML=''"
				class="px-5 py-4 space-y-3"
			>
				<div>
					<label class="block text-xs font-medium text-slate-600 mb-1">Name <span class="text-red-500">*</span></label>
					<input type="text" name="name" value={ s.Name } required
						class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-600 mb-1">Contact person</label>
					<input type="text" name="contact_person" value={ s.ContactPerson }
						class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm"/>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<div>
						<label class="block text-xs font-medium text-slate-600 mb-1">Phone</label>
						<input type="text" name="phone" value={ s.Phone }
							class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm"/>
					</div>
					<div>
						<label class="block text-xs font-medium text-slate-600 mb-1">Email</label>
						<input type="email" name="email" value={ s.Email }
							class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm"/>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-slate-600 mb-1">Address</label>
					<textarea name="address" rows="2"
						class="w-full border border-slate-300 rounded-md px-2 py-1.5 text-sm">{ s.Address }</textarea>
				</div>

				<div class="flex justify-end gap-2 pt-2">
					<button type="button"
						onclick="document.getElementById('modal-root').innerHTML=''"
						class="px-3 py-1.5 text-sm rounded-md border border-slate-300 hover:bg-slate-50"
					>Cancel</button>
					<button type="submit"
						class="px-3 py-1.5 text-sm rounded-md bg-slate-800 text-white hover:bg-slate-700"
					>Save changes</button>
				</div>
			</form>
		</div>
	</div>
}

// ---------- Purchases table (supplier detail page) ----------

templ PurchasesTable(purchases []suppliers.PurchaseRow) {
	<div class="bg-white border border-slate-200 rounded-lg overflow-hidden">
		<table class="w-full text-sm">
			<thead class="bg-slate-50 text-slate-600">
				<tr>
					<th class="text-left px-3 py-2 font-medium">Date</th>
					<th class="text-left px-3 py-2 font-medium">Product</th>
					<th class="text-left px-3 py-2 font-medium">Type</th>
					<th class="text-right px-3 py-2 font-medium">Qty</th>
					<th class="text-right px-3 py-2 font-medium">Unit cost</th>
					<th class="text-left px-3 py-2 font-medium">Reference / Notes</th>
					<th class="text-left px-3 py-2 font-medium">User</th>
				</tr>
			</thead>
			<tbody class="divide-y divide-slate-100">
				if len(purchases) == 0 {
					<tr>
						<td colspan="7" class="px-3 py-6 text-center text-slate-500">No purchases recorded yet.</td>
					</tr>
				}
				for _, p := range purchases {
					<tr>
						<td class="px-3 py-2 text-slate-600 whitespace-nowrap">
							{ p.MovementDate.Format("2006-01-02 15:04") }
						</td>
						<td class="px-3 py-2">
							<div class="font-medium text-slate-800">{ p.ProductName }</div>
							<div class="text-xs font-mono text-slate-500">{ p.SKU }</div>
						</td>
						<td class="px-3 py-2">
							if p.Type == "in" {
								<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-emerald-100 text-emerald-700">in</span>
							} else if p.Type == "out" {
								<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-rose-100 text-rose-700">out</span>
							} else {
								<span class="inline-block px-2 py-0.5 rounded-full text-xs font-medium bg-amber-100 text-amber-700">adjust</span>
							}
						</td>
						<td class="px-3 py-2 text-right tabular-nums">{ fmt.Sprint(p.Quantity) }</td>
						<td class="px-3 py-2 text-right tabular-nums text-slate-600">
							if p.UnitCost != nil {
								{ fmt.Sprintf("%.2f", *p.UnitCost) }
							} else {
								<span class="text-slate-400">—</span>
							}
						</td>
						<td class="px-3 py-2 text-slate-600">
							if p.Reference != "" {
								<div class="text-xs text-slate-700">{ p.Reference }</div>
							}
							if p.Notes != "" {
								<div class="text-xs text-slate-500">{ p.Notes }</div>
							}
						</td>
						<td class="px-3 py-2 text-slate-600">{ p.Username }</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
}