// views/pages/suppliers.templ
package pages

import (
	"fmt"

	"github.com/jmechavez/vapeshop/internal/auth"
	"github.com/jmechavez/vapeshop/internal/suppliers"
	"github.com/jmechavez/vapeshop/views/layouts"
	"github.com/jmechavez/vapeshop/views/partials"
)

templ SuppliersPage(sess *auth.Session, list []suppliers.SupplierWithStats) {
	@layouts.Shell(sess, "Suppliers", "Suppliers") {
		<!-- Page header -->
		<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5 sm:mb-6">
			<div>
				<h1 class="font-display italic uppercase tracking-wider text-2xl sm:text-3xl lg:text-4xl leading-none">
					Suppliers
				</h1>
				<p class="text-sm text-zinc-400 mt-2">Manage your vendors and see their purchase history.</p>
			</div>
			<button
				hx-get="/suppliers/new"
				hx-target="#modal-root"
				hx-swap="innerHTML"
				class="min-h-[44px] inline-flex items-center justify-center gap-2 px-4 py-3 sm:py-2 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition self-start sm:self-auto sm:shadow-[0_0_15px_rgba(163,230,53,0.35)]"
			>
				<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
					<line x1="12" y1="5" x2="12" y2="19"></line>
					<line x1="5" y1="12" x2="19" y2="12"></line>
				</svg>
				Add supplier
			</button>
		</div>

		@partials.SuppliersTable(list)

		<div id="modal-root"></div>
	}
}

templ SupplierDetailPage(sess *auth.Session, s suppliers.Supplier, purchases []suppliers.PurchaseRow) {
	@layouts.Shell(sess, "Supplier: "+s.Name, "Suppliers") {
		<!-- Page header -->
		<div class="flex flex-col sm:flex-row sm:items-end sm:justify-between gap-3 mb-5 sm:mb-6">
			<div class="min-w-0">
				<div class="text-xs text-zinc-500 mb-1">
					<a href="/suppliers" class="hover:text-lime-400 transition">Suppliers</a>
					<span class="text-zinc-700"> / </span>
					<span>{ s.Name }</span>
				</div>
				<h1 class="font-display italic uppercase tracking-wider text-2xl sm:text-3xl lg:text-4xl leading-none truncate">
					{ s.Name }
				</h1>
			</div>
			<a
				href="/suppliers"
				class="min-h-[44px] inline-flex items-center justify-center px-4 py-3 sm:py-2 rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-sm font-medium active:scale-95 transition self-start sm:self-auto"
			>
				Back to suppliers
			</a>
		</div>

		<!-- Contact + summary grid -->
		<div class="grid grid-cols-1 md:grid-cols-3 gap-3 sm:gap-4 mb-6">
			<div class="bg-zinc-900 border border-zinc-800 rounded-md p-4 sm:p-5 md:col-span-2">
				<h2 class="font-display italic uppercase tracking-wider text-sm text-zinc-300 mb-3">Contact</h2>
				<dl class="grid grid-cols-1 sm:grid-cols-2 gap-4 text-sm">
					<div>
						<dt class="text-xs uppercase tracking-wide text-zinc-500">Contact person</dt>
						<dd class="text-zinc-200 mt-1">
							if s.ContactPerson != "" {
								{ s.ContactPerson }
							} else {
								<span class="text-zinc-600">—</span>
							}
						</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-wide text-zinc-500">Phone</dt>
						<dd class="text-zinc-200 mt-1">
							if s.Phone != "" {
								{ s.Phone }
							} else {
								<span class="text-zinc-600">—</span>
							}
						</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-wide text-zinc-500">Email</dt>
						<dd class="text-zinc-200 mt-1 break-all">
							if s.Email != "" {
								{ s.Email }
							} else {
								<span class="text-zinc-600">—</span>
							}
						</dd>
					</div>
					<div>
						<dt class="text-xs uppercase tracking-wide text-zinc-500">Address</dt>
						<dd class="text-zinc-200 mt-1">
							if s.Address != "" {
								{ s.Address }
							} else {
								<span class="text-zinc-600">—</span>
							}
						</dd>
					</div>
				</dl>
			</div>

			<div class="bg-zinc-900 border border-zinc-800 rounded-md p-4 sm:p-5">
				<h2 class="font-display italic uppercase tracking-wider text-sm text-zinc-300 mb-3">Summary</h2>
				<div>
					<div class="text-xs uppercase tracking-wide text-zinc-500">Total movements</div>
					<div class="font-display text-3xl text-lime-400 mt-1 tabular-nums">{ fmt.Sprint(len(purchases)) }</div>
				</div>
			</div>
		</div>

		<!-- Purchases -->
		<h2 class="font-display italic uppercase tracking-wider text-lg sm:text-xl mb-3">Purchase History</h2>
		@partials.PurchasesTable(purchases)

		<div id="modal-root"></div>
	}
}