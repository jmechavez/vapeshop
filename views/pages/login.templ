package pages

import "github.com/jmechavez/vapeshop/views/layouts"

templ Login(errMsg string) {
	@layouts.Base("Login") {
		<main class="max-w-sm mx-auto px-4 py-16">
			<h1 class="text-3xl font-bold mb-6 text-center">Drift Culture</h1>
			<h2 class="text-lg text-gray-600 mb-6 text-center">Staff Login</h2>

			if errMsg != "" {
				<div class="mb-4 px-4 py-3 rounded-sm bg-red-100 text-red-800 text-sm">
					{ errMsg }
				</div>
			}

			<form method="POST" action="/login" class="space-y-4">
				<div>
					<label class="block text-sm font-medium mb-1" for="username">Username</label>
					<input id="username" name="username" type="text" required
					       autocomplete="username"
					       class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:outline-none focus:ring-2 focus:ring-black"/>
				</div>
				<div>
					<label class="block text-sm font-medium mb-1" for="password">Password</label>
					<input id="password" name="password" type="password" required
					       autocomplete="current-password"
					       class="w-full px-3 py-2 border border-gray-300 rounded-sm focus:outline-none focus:ring-2 focus:ring-black"/>
				</div>
				<button type="submit"
				        class="w-full py-3 rounded-sm bg-black text-white font-medium">
					Sign in
				</button>
			</form>
		</main>
	}
}