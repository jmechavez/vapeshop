package pages

import (
	"github.com/jmechavez/vapeshop/internal/auth"
	"github.com/jmechavez/vapeshop/internal/products"
	"github.com/jmechavez/vapeshop/views/layouts"
	"github.com/jmechavez/vapeshop/views/partials"
)

templ Products(sess *auth.Session, list []products.ProductWithStock, q string) {
	@layouts.Shell(sess, "Products", "Products") {
		<div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mb-4">
			<h1 class="text-2xl font-semibold">Products</h1>
			<button
				hx-get="/products/new"
				hx-target="#modal"
				hx-swap="innerHTML"
				class="px-4 py-3 rounded-sm bg-black text-white text-sm font-medium">
				+ Add Product
			</button>
		</div>

		<div class="mb-4">
			<input
				type="search"
				name="q"
				placeholder="Search name, SKU, brand..."
				value={ q }
				hx-get="/products/search"
				hx-target="#products-table"
				hx-swap="outerHTML"
				hx-trigger="keyup changed delay:300ms, search"
				class="w-full px-3 py-3 border border-gray-300 rounded-sm"/>
		</div>

		@partials.ProductsTable(list)

		<div id="modal"></div>
	}
}