package pages

import "github.com/jmechavez/vapeshop/views/layouts"

templ Login(errMsg string) {
	@layouts.Base("Login") {
		<main class="min-h-screen flex items-center justify-center px-4 sm:px-6 py-12 bg-zinc-950">
			<div class="w-full max-w-sm">
				<!-- Logo / brand -->
				<div class="flex flex-col items-center mb-6 sm:mb-8">
					<img
						src="/static/img/dc-logo.jpg"
						alt="Drift Culture"
						class="h-24 w-24 sm:h-32 sm:w-32 object-contain rounded-md mb-4"
					/>
					<h1 class="font-display italic uppercase tracking-wider text-3xl sm:text-4xl leading-none text-center">
						Drift<span class="text-lime-400">Culture</span>
					</h1>
					<p class="mt-2 text-sm text-zinc-400">Staff Login</p>
				</div>

				<!-- Card -->
				<div class="bg-zinc-900 border border-zinc-800 rounded-md p-5 sm:p-6 shadow-lg">
					if errMsg != "" {
						<div class="mb-4 px-3 py-2 rounded-sm bg-red-500/10 border border-red-500/40 text-red-500 text-sm toast-in">
							{ errMsg }
						</div>
					}

					<form method="POST" action="/login" class="space-y-4">
						<div>
							<label for="username" class="block text-sm font-medium text-zinc-300 mb-1">
								Username
							</label>
							<input
								id="username"
								name="username"
								type="text"
								required
								autocomplete="username"
								class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"
							/>
						</div>

						<div>
							<label for="password" class="block text-sm font-medium text-zinc-300 mb-1">
								Password
							</label>
							<input
								id="password"
								name="password"
								type="password"
								required
								autocomplete="current-password"
								class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white placeholder-zinc-500 focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"
							/>
						</div>

						<button
							type="submit"
							class="w-full min-h-[44px] py-3 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition sm:shadow-[0_0_15px_rgba(163,230,53,0.35)]"
						>
							Sign in
						</button>
					</form>
				</div>

				<p class="mt-6 text-center text-xs text-zinc-600">
					Drift Culture • Inventory &amp; POS
				</p>
			</div>
		</main>
	}
}