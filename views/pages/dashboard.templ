package pages

import (
	"github.com/jmechavez/vapeshop/internal/auth"
	"github.com/jmechavez/vapeshop/views/layouts"
)

templ Dashboard(sess *auth.Session) {
	@layouts.Shell(sess, "Dashboard", "Dashboard") {
		<h1 class="text-2xl font-semibold mb-2">Dashboard</h1>
		<p class="text-gray-600">Welcome, { sess.FullName }. Stats coming in Phase 7.</p>
	}
}