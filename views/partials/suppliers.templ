package partials

import (
	"fmt"

	"github.com/jmechavez/vapeshop/internal/suppliers"
)

templ SuppliersTable(list []suppliers.SupplierWithStats) {
	<div id="suppliers-table" class="bg-zinc-900 border border-zinc-800 rounded-md overflow-hidden">
		<div class="hidden md:block overflow-x-auto">
			<table class="min-w-full text-sm">
				<thead class="bg-zinc-950/60 text-zinc-400">
					<tr>
						<th class="text-left font-medium px-4 py-2">Name</th>
						<th class="text-left font-medium px-4 py-2">Contact</th>
						<th class="text-left font-medium px-4 py-2">Phone</th>
						<th class="text-left font-medium px-4 py-2">Email</th>
						<th class="text-right font-medium px-4 py-2">Movements</th>
						<th class="text-left font-medium px-4 py-2">Last activity</th>
						<th class="text-right font-medium px-4 py-2">Actions</th>
					</tr>
				</thead>
				<tbody id="supplier-rows">
					if len(list) == 0 {
						<tr>
							<td colspan="7" class="px-4 py-12 text-center">
								<p class="text-zinc-400 text-sm">No suppliers yet.</p>
							</td>
						</tr>
					}
					for _, s := range list {
						@SupplierRow(s)
					}
				</tbody>
			</table>
		</div>

		<div class="md:hidden divide-y divide-zinc-800">
			if len(list) == 0 {
				<div class="px-6 py-12 text-center">
					<p class="text-zinc-400 text-sm">No suppliers yet.</p>
				</div>
			}
			for _, s := range list {
				@SupplierCardMobile(s)
			}
		</div>
	</div>
}

templ SupplierRow(s suppliers.SupplierWithStats) {
	<tr id={ "supplier-row-" + fmt.Sprint(s.ID) } class="border-t border-zinc-800 hover:bg-zinc-800/40 transition">
		<td class="px-4 py-2">
			<a href={ templ.SafeURL("/suppliers/" + fmt.Sprint(s.ID)) } class="font-medium text-white hover:text-lime-400 transition">
				{ s.Name }
			</a>
		</td>
		<td class="px-4 py-2 text-zinc-300">
			if s.ContactPerson != "" {
				{ s.ContactPerson }
			} else {
				<span class="text-zinc-600">—</span>
			}
		</td>
		<td class="px-4 py-2 text-zinc-300">
			if s.Phone != "" {
				{ s.Phone }
			} else {
				<span class="text-zinc-600">—</span>
			}
		</td>
		<td class="px-4 py-2 text-zinc-300">
			if s.Email != "" {
				{ s.Email }
			} else {
				<span class="text-zinc-600">—</span>
			}
		</td>
		<td class="px-4 py-2 text-right tabular-nums text-zinc-200">{ fmt.Sprint(s.MovementCount) }</td>
		<td class="px-4 py-2 text-zinc-400 text-xs whitespace-nowrap">
			if s.LastMovement != nil {
				{ s.LastMovement.Format("2006-01-02 15:04") }
			} else {
				<span class="text-zinc-600">—</span>
			}
		</td>
		<td class="px-4 py-2 text-right space-x-2 whitespace-nowrap">
			<button
				hx-get={ "/suppliers/" + fmt.Sprint(s.ID) + "/edit" }
				hx-target="#modal-root"
				hx-swap="innerHTML"
				class="px-3 py-1.5 text-xs rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white active:scale-95 transition"
			>
				Edit
			</button>
			<button
				type="button"
				data-confirm="yes"
				data-title="Delete Supplier"
				data-message={ "Delete \"" + s.Name + "\"? This cannot be undone." }
				data-confirm-text="Delete"
				data-destructive="true"
				data-method="DELETE"
				data-url={ "/suppliers/" + fmt.Sprint(s.ID) }
				data-target={ "#supplier-row-" + fmt.Sprint(s.ID) }
				data-handler="supplier"
				class="px-3 py-1.5 text-xs rounded-sm border border-red-500/40 text-red-500 hover:bg-red-500/10 active:scale-95 transition"
			>
				Delete
			</button>
		</td>
	</tr>
}

templ SupplierCardMobile(s suppliers.SupplierWithStats) {
	<div id={ "supplier-card-" + fmt.Sprint(s.ID) } class="px-4 py-3">
		<a href={ templ.SafeURL("/suppliers/" + fmt.Sprint(s.ID)) } class="block active:bg-zinc-800/50 transition -mx-4 px-4 -my-3 py-3">
			<div class="flex items-start justify-between gap-2">
				<div class="min-w-0 flex-1">
					<div class="font-medium text-white truncate">{ s.Name }</div>
					if s.ContactPerson != "" {
						<div class="text-xs text-zinc-400 mt-0.5">{ s.ContactPerson }</div>
					}
					if s.Phone != "" || s.Email != "" {
						<div class="text-xs text-zinc-500 mt-1 space-x-2">
							if s.Phone != "" {
								<span>{ s.Phone }</span>
							}
							if s.Email != "" {
								<span class="break-all">{ s.Email }</span>
							}
						</div>
					}
				</div>
				<div class="text-right shrink-0">
					<div class="text-[10px] uppercase tracking-wide text-zinc-500">Movements</div>
					<div class="font-display text-base text-lime-400 tabular-nums">{ fmt.Sprint(s.MovementCount) }</div>
				</div>
			</div>
			<div class="mt-2 text-xs text-zinc-500">
				if s.LastMovement != nil {
					Last: { s.LastMovement.Format("Jan 02, 3:04 PM") }
				} else {
					No activity yet
				}
			</div>
		</a>
		<div class="mt-3 flex items-center gap-2">
			<button
				type="button"
				hx-get={ "/suppliers/" + fmt.Sprint(s.ID) + "/edit" }
				hx-target="#modal-root"
				hx-swap="innerHTML"
				class="min-h-[40px] flex-1 px-3 py-2 text-sm rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white active:scale-95 transition"
			>
				Edit
			</button>
			<button
				type="button"
				data-confirm="yes"
				data-title="Delete Supplier"
				data-message={ "Delete \"" + s.Name + "\"? This cannot be undone." }
				data-confirm-text="Delete"
				data-destructive="true"
				data-method="DELETE"
				data-url={ "/suppliers/" + fmt.Sprint(s.ID) }
				data-target={ "#supplier-card-" + fmt.Sprint(s.ID) }
				data-handler="supplier"
				class="min-h-[40px] px-3 py-2 text-sm rounded-sm border border-red-500/40 text-red-500 hover:bg-red-500/10 active:scale-95 transition"
			>
				Delete
			</button>
		</div>
	</div>
}

templ SupplierNewModal(in suppliers.Input, errMsg string) {
	<div class="modal-backdrop" data-modal>
		<div class="modal-panel">
			<div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between">
				<h2 class="font-display italic uppercase tracking-wider text-lg">New Supplier</h2>
				<button type="button" onclick="document.getElementById('modal-root').innerHTML=''" class="h-9 w-9 inline-flex items-center justify-center rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-white active:scale-95 transition" aria-label="Close">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			<form hx-post="/suppliers" hx-target="#suppliers-table" hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful) document.getElementById('modal-root').innerHTML=''" class="p-5 space-y-3">
				if errMsg != "" {
					<div class="px-3 py-2 rounded-sm bg-red-500/10 border border-red-500/40 text-red-500 text-sm">{ errMsg }</div>
				}
				<div>
					<label class="block text-xs font-medium text-zinc-400 mb-1">Name <span class="text-red-500">*</span></label>
					<input type="text" name="name" value={ in.Name } required class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-zinc-400 mb-1">Contact person</label>
					<input type="text" name="contact_person" value={ in.ContactPerson } class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<div>
						<label class="block text-xs font-medium text-zinc-400 mb-1">Phone</label>
						<input type="text" name="phone" value={ in.Phone } class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
					</div>
					<div>
						<label class="block text-xs font-medium text-zinc-400 mb-1">Email</label>
						<input type="email" name="email" value={ in.Email } class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-zinc-400 mb-1">Address</label>
					<textarea name="address" rows="2" class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition">{ in.Address }</textarea>
				</div>
				<div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
					<button type="button" onclick="document.getElementById('modal-root').innerHTML=''" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-sm active:scale-95 transition">Cancel</button>
					<button type="submit" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition">Create</button>
				</div>
			</form>
		</div>
	</div>
}

templ SupplierEditModal(s suppliers.Supplier, errMsg string) {
	<div class="modal-backdrop" data-modal>
		<div class="modal-panel">
			<div class="px-5 py-4 border-b border-zinc-800 flex items-center justify-between">
				<h2 class="font-display italic uppercase tracking-wider text-lg">Edit Supplier</h2>
				<button type="button" onclick="document.getElementById('modal-root').innerHTML=''" class="h-9 w-9 inline-flex items-center justify-center rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-400 hover:text-white active:scale-95 transition" aria-label="Close">
					<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="h-4 w-4">
						<line x1="18" y1="6" x2="6" y2="18"></line>
						<line x1="6" y1="6" x2="18" y2="18"></line>
					</svg>
				</button>
			</div>
			<form hx-put={ "/suppliers/" + fmt.Sprint(s.ID) } hx-target={ "#supplier-row-" + fmt.Sprint(s.ID) } hx-swap="outerHTML" hx-on::after-request="if(event.detail.successful) document.getElementById('modal-root').innerHTML=''" class="p-5 space-y-3">
				if errMsg != "" {
					<div class="px-3 py-2 rounded-sm bg-red-500/10 border border-red-500/40 text-red-500 text-sm">{ errMsg }</div>
				}
				<div>
					<label class="block text-xs font-medium text-zinc-400 mb-1">Name <span class="text-red-500">*</span></label>
					<input type="text" name="name" value={ s.Name } required class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
				</div>
				<div>
					<label class="block text-xs font-medium text-zinc-400 mb-1">Contact person</label>
					<input type="text" name="contact_person" value={ s.ContactPerson } class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
				</div>
				<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
					<div>
						<label class="block text-xs font-medium text-zinc-400 mb-1">Phone</label>
						<input type="text" name="phone" value={ s.Phone } class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
					</div>
					<div>
						<label class="block text-xs font-medium text-zinc-400 mb-1">Email</label>
						<input type="email" name="email" value={ s.Email } class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition"/>
					</div>
				</div>
				<div>
					<label class="block text-xs font-medium text-zinc-400 mb-1">Address</label>
					<textarea name="address" rows="2" class="w-full text-base px-3 py-3 sm:py-2 bg-zinc-950 border border-zinc-800 rounded-sm text-white focus:outline-none focus:border-lime-400 focus:ring-2 focus:ring-lime-400/30 transition">{ s.Address }</textarea>
				</div>
				<div class="flex flex-col-reverse sm:flex-row sm:justify-end gap-2 pt-2">
					<button type="button" onclick="document.getElementById('modal-root').innerHTML=''" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm border border-zinc-800 hover:border-zinc-700 text-zinc-300 hover:text-white text-sm active:scale-95 transition">Cancel</button>
					<button type="submit" class="min-h-[44px] px-4 py-3 sm:py-2 rounded-sm bg-lime-400 text-black font-semibold uppercase tracking-wide text-sm hover:bg-lime-300 active:scale-95 transition">Save changes</button>
				</div>
			</form>
		</div>
	</div>
}

templ PurchasesTable(purchases []suppliers.PurchaseRow) {
	<div class="bg-zinc-900 border border-zinc-800 rounded-md overflow-hidden">
		<div class="hidden md:block overflow-x-auto">
			<table class="min-w-full text-sm">
				<thead class="bg-zinc-950/60 text-zinc-400">
					<tr>
						<th class="text-left font-medium px-3 py-2">Date</th>
						<th class="text-left font-medium px-3 py-2">Product</th>
						<th class="text-left font-medium px-3 py-2">Type</th>
						<th class="text-right font-medium px-3 py-2">Qty</th>
						<th class="text-right font-medium px-3 py-2">Unit cost</th>
						<th class="text-left font-medium px-3 py-2">Reference / Notes</th>
						<th class="text-left font-medium px-3 py-2">User</th>
					</tr>
				</thead>
				<tbody>
					if len(purchases) == 0 {
						<tr>
							<td colspan="7" class="px-3 py-12 text-center">
								<p class="text-zinc-400 text-sm">No purchases recorded yet.</p>
							</td>
						</tr>
					}
					for _, p := range purchases {
						<tr class="border-t border-zinc-800 hover:bg-zinc-800/40 transition">
							<td class="px-3 py-2 text-zinc-400 text-xs whitespace-nowrap">{ p.MovementDate.Format("2006-01-02 15:04") }</td>
							<td class="px-3 py-2">
								<div class="font-medium text-white">{ p.ProductName }</div>
								<div class="text-xs font-mono text-zinc-500">{ p.SKU }</div>
							</td>
							<td class="px-3 py-2">@purchaseTypeBadge(p.Type)</td>
							<td class="px-3 py-2 text-right tabular-nums text-zinc-200">{ fmt.Sprint(p.Quantity) }</td>
							<td class="px-3 py-2 text-right tabular-nums text-zinc-300">
								if p.UnitCost != nil {
									{ fmt.Sprintf("%.2f", *p.UnitCost) }
								} else {
									<span class="text-zinc-600">—</span>
								}
							</td>
							<td class="px-3 py-2 text-zinc-400">
								if p.Reference != "" {
									<div class="text-xs font-mono text-zinc-300">{ p.Reference }</div>
								}
								if p.Notes != "" {
									<div class="text-xs text-zinc-500">{ p.Notes }</div>
								}
							</td>
							<td class="px-3 py-2 text-zinc-300">{ p.Username }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
		<div class="md:hidden divide-y divide-zinc-800">
			if len(purchases) == 0 {
				<div class="px-6 py-12 text-center">
					<p class="text-zinc-400 text-sm">No purchases recorded yet.</p>
				</div>
			}
			for _, p := range purchases {
				<div class="px-4 py-3">
					<div class="flex items-start justify-between gap-2">
						<div class="min-w-0 flex-1">
							<div class="font-medium text-white truncate">{ p.ProductName }</div>
							<div class="text-xs font-mono text-zinc-500 mt-0.5">{ p.SKU }</div>
							<div class="text-xs text-zinc-500 mt-1">{ p.MovementDate.Format("Jan 02, 3:04 PM") }</div>
						</div>
						<div class="text-right shrink-0">
							<div class="font-display text-base text-zinc-200 tabular-nums">+{ fmt.Sprint(p.Quantity) }</div>
							<div class="mt-1">@purchaseTypeBadge(p.Type)</div>
						</div>
					</div>
					<div class="mt-2 text-xs text-zinc-400 space-y-0.5">
						if p.UnitCost != nil {
							<div>Unit cost: <span class="text-zinc-300 tabular-nums">{ fmt.Sprintf("%.2f", *p.UnitCost) }</span></div>
						}
						if p.Username != "" {
							<div>By: <span class="text-zinc-300">{ p.Username }</span></div>
						}
						if p.Reference != "" {
							<div class="font-mono">Ref: <span class="text-zinc-300">{ p.Reference }</span></div>
						}
						if p.Notes != "" {
							<div class="italic">"{ p.Notes }"</div>
						}
					</div>
				</div>
			}
		</div>
	</div>
}

templ purchaseTypeBadge(t string) {
	if t == "in" {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-lime-400/10 text-lime-400 border border-lime-400/30">
			<span class="h-1.5 w-1.5 rounded-full bg-lime-400"></span>in
		</span>
	} else if t == "out" {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-red-500/10 text-red-500 border border-red-500/30">
			<span class="h-1.5 w-1.5 rounded-full bg-red-500"></span>out
		</span>
	} else {
		<span class="inline-flex items-center gap-1 px-2 py-0.5 rounded-sm text-[10px] uppercase tracking-wide bg-zinc-800 text-zinc-300 border border-zinc-700">
			<span class="h-1.5 w-1.5 rounded-full bg-zinc-400"></span>adjust
		</span>
	}
}