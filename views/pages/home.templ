package pages

import "github.com/jmechavez/vapeshop/views/layouts"

templ Home() {
	@layouts.Base("Home") {
		<header class="bg-white shadow-sm">
			<div class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
				<h1 class="text-2xl font-bold">Drift Culture</h1>
				<a href="/login"
				   class="px-4 py-2 rounded-sm bg-black text-white flex items-center">
					Login
				</a>
			</div>
		</header>
		<main class="max-w-6xl mx-auto px-4 py-10">
			<h2 class="text-3xl font-semibold mb-2">Welcome to Drift Culture</h2>
			<p class="text-gray-600">Featured products coming soon.</p>
		</main>
	}
}